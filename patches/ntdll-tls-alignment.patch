+/* alignment requested through IMAGE_SCN_ALIGN_* bits of the TLS directory Characteristics */
+static ULONG_PTR get_tls_alignment( const IMAGE_TLS_DIRECTORY *dir )
+{
+    ULONG shift = (dir->Characteristics >> 20) & 0xf;
+    return shift ? (ULONG_PTR)1 << (shift - 1) : 0;
+}
